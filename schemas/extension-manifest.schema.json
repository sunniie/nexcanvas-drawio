{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sunniie/nexcanvas-drawio/schemas/extension-manifest.schema.json",
  "title": "NexCanvas Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apiVersion", "id", "name", "version", "requiresNexCanvas", "components"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "apiVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "requiresNexCanvas": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": {"enum": ["analyzer", "layout", "route", "asset-provider", "qa-rule", "host-adapter"]},
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "protocolVersion": {"const": "1.0"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
          "fileSuffixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
