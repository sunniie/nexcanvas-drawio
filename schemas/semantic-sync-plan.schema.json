{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexcanvas.dev/schemas/semantic-sync-plan.schema.json",
  "title": "NexCanvas Semantic Sync Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "createdAt",
    "projectRoot",
    "baselineFingerprint",
    "incomingFingerprint",
    "currentSemanticFingerprint",
    "mergedSemanticFingerprint",
    "sourceRevision",
    "summary",
    "complete",
    "operations",
    "conflicts",
    "pendingRemovals",
    "diff"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "createdAt": {"type": "string", "minLength": 1},
    "projectRoot": {"const": "."},
    "baselineFingerprint": {"type": "string"},
    "incomingFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "currentSemanticFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mergedSemanticFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "summary": {
      "type": "object",
      "required": ["operations", "conflicts", "pendingRemovals", "diagnostics"],
      "properties": {
        "operations": {"type": "integer", "minimum": 0},
        "conflicts": {"type": "integer", "minimum": 0},
        "pendingRemovals": {"type": "integer", "minimum": 0},
        "diagnostics": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "complete": {"type": "boolean"},
    "operations": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "pendingRemovals": {"type": "array", "items": {"type": "object"}},
    "diff": {"type": "object"},
    "mode": {"enum": ["dry-run", "apply"]},
    "projectModified": {"type": "boolean"},
    "snapshot": {"type": "string"}
  },
  "additionalProperties": false
}
