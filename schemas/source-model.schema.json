{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexcanvas.dev/schemas/source-model.schema.json",
  "title": "NexCanvas Source Model",
  "type": "object",
  "required": ["schemaVersion", "status", "sources", "facts", "assumptions"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "status": {"enum": ["draft", "confirmed"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "location"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["repository", "document", "image", "url", "web", "conversation", "manual", "visual-reference"]},
          "location": {"type": "string"},
          "snapshot": {"type": "string"},
          "repository": {
            "type": "object",
            "required": ["remote", "revision", "dirty", "capturedAt"],
            "properties": {
              "remote": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
              "dirty": {"type": "boolean"},
              "capturedAt": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "repository"}}},
            "then": {"required": ["repository"]}
          }
        ]
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["sourceId", "path", "startLine", "endLine"],
                  "properties": {
                    "sourceId": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "minLength": 1},
                    "startLine": {"type": "integer", "minimum": 1},
                    "endLine": {"type": "integer", "minimum": 1},
                    "blob": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
                    "label": {"type": "string"}
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "confidence": {"enum": ["confirmed", "inferred", "unknown"]}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
