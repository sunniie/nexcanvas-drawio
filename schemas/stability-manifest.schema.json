{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexcanvas.dev/schemas/stability-manifest.schema.json",
  "title": "NexCanvas Stability Manifest",
  "type": "object",
  "required": ["schemaVersion", "contractSet", "stableFrom", "supportLine", "platforms", "cli", "contracts", "policies"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "contractSet": {"const": "1.0"},
    "stableFrom": {"const": "1.0.0"},
    "supportLine": {"const": "1.x"},
    "platforms": {"type": "object"},
    "cli": {
      "type": "object",
      "required": ["command", "outputEncoding", "machineOutput", "exitCodes", "commands"],
      "properties": {
        "command": {"const": "nexcanvas"},
        "outputEncoding": {"const": "UTF-8"},
        "machineOutput": {"const": "JSON"},
        "exitCodes": {"type": "object"},
        "globalOptions": {"type": "array", "items": {"type": "string", "pattern": "^-{1,2}"}},
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "positionals", "options"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "positionals": {"type": "array", "items": {"type": "string"}},
              "options": {"type": "array", "items": {"type": "string", "pattern": "^-{1,2}"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "schema"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["stable", "compatibility"]},
          "schema": {"type": "string", "pattern": "^schemas/[^/]+\\.json$"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "policies": {"type": "object"}
  },
  "additionalProperties": false
}
