{
  "schemaVersion": "1.0",
  "apiVersion": "1.0",
  "id": "org.example.complete",
  "name": "Complete test extension",
  "version": "1.0.0",
  "requiresNexCanvas": ">=0.5.0,<0.8.0",
  "components": [
    {
      "kind": "analyzer",
      "id": "golang",
      "protocolVersion": "1.0",
      "fileSuffixes": [".go"],
      "command": ["{python}", "hook.py"]
    },
    {
      "kind": "layout",
      "id": "fixture-layout",
      "protocolVersion": "1.0",
      "command": ["{python}", "hook.py"]
    },
    {
      "kind": "qa-rule",
      "id": "fixture-rule",
      "protocolVersion": "1.0",
      "command": ["{python}", "hook.py"]
    },
    {"kind": "route", "id": "fixture-route", "source": "route.json"},
    {"kind": "asset-provider", "id": "fixture-icons", "source": "provider.json"},
    {"kind": "host-adapter", "id": "fixture-host", "source": "host.json"}
  ]
}
